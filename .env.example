# ---------------------------------------------------------------------------
# Neon Postgres (provision via Vercel Marketplace -> Storage -> Neon)
# ---------------------------------------------------------------------------
# IMPORTANT: use the POOLED connection string (host contains "-pooler").
# Serverless functions exhaust direct connections, so the pooled URL is
# required for anything running on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Direct (non-pooled) URL used only by `prisma migrate`.
# Neon's Vercel integration injects this automatically as DATABASE_URL_UNPOOLED.
# For local dev, use the non-pooler host (no "-pooler" in the hostname).
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require"

# ---------------------------------------------------------------------------
# Single-user auth gate (REQUIRED - do not deploy without it)
# ---------------------------------------------------------------------------
# The password the single user types on the login screen.
APP_PASSWORD="change-me-to-a-long-random-string"

# A long random secret used to sign the session cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-another-long-random-string"

# ---------------------------------------------------------------------------
# AI scenario suggestions (OPTIONAL)
# ---------------------------------------------------------------------------
# If set, the "Suggest scenarios (AI)" button proposes feature-specific test
# cases from the feature description. Without it, the button is disabled and
# everything else still works.
# ANTHROPIC_API_KEY="sk-ant-..."
# Optional model override (defaults to claude-opus-5). Use a cheaper model if
# you prefer, e.g. claude-sonnet-5 or claude-haiku-4-5.
# ANTHROPIC_MODEL="claude-opus-5"
