# ---------------------------------------------------------------------------
# Neon Postgres (provision via Vercel Marketplace -> Storage -> Neon)
# ---------------------------------------------------------------------------
# IMPORTANT: use the POOLED connection string (host contains "-pooler").
# Serverless functions exhaust direct connections, so the pooled URL is
# required for anything running on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Optional: a direct (non-pooled) URL used only by `prisma migrate`.
# Neon exposes this as the non-pooler host. If you run migrations from the
# Vercel/Neon pooled endpoint only, you can set this to the same value.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require"

# ---------------------------------------------------------------------------
# Single-user auth gate (REQUIRED - do not deploy without it)
# ---------------------------------------------------------------------------
# The password the single user types on the login screen.
APP_PASSWORD="change-me-to-a-long-random-string"

# A long random secret used to sign the session cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-another-long-random-string"
